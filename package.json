{
  "name": "esbee-dao-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Esbee DAO website.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx smoke-test.ts",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "dev": "pnpm run build && python3 -m http.server 8080 --directory dist",
    "icons": "node scripts/make-icons.mjs",
    "shot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@stacks/connect": "^8.2.7",
    "@stacks/transactions": "^7.6.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.9.0"
}
